{
  "name": "golfswing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/copy-mediapipe.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --check public/pose-worker.js && node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "prepare:assets": "node scripts/copy-mediapipe.mjs",
    "format:check": "prettier --check src tests public/pose-worker.js scripts package.json tsconfig.json postcss.config.mjs"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "type": "module"
}
